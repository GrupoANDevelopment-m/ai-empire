    "Reformat per Channel": {"main": [[{"node": "Has X?", "type": "main", "index": 0}, {"node": "Has LinkedIn?", "type": "main", "index": 0}, {"node": "Post to Facebook", "type": "main", "index": 0}, {"node": "Post to Telegram", "type": "main", "index": 0}]]},
    "Has X?": {"main": [[{"node": "Post to X", "type": "main", "index": 0}]]},
    "Has LinkedIn?": {"main": [[{"node": "Post to LinkedIn", "type": "main", "index": 0}]]},
    "Post to X": {"main": [[{"node": "Log to Postgres", "type": "main", "index": 0}]]},
    "Post to LinkedIn": {"main": [[{"node": "Log to Postgres", "type": "main", "index": 0}]]},
    "Post to Facebook": {"main": [[{"node": "Log to Postgres", "type": "main", "index": 0}]]},
    "Post to Telegram": {"main": [[{"node": "Log to Postgres", "type": "main", "index": 0}]]}
  }
}
