# AI Empire — Environment Variables
# Copy this file to .env and fill in real values.

# ============================================================================
# REQUIRED: JWT secret (must be 32+ bytes)
# ============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-real-32-byte-random-secret
SECRET_KEY=replace-me-with-a-real-32-byte-random-secret

# ============================================================================
# LLM Provider (one of these should be set)
# ============================================================================

# NVIDIA NIM (FREE — recommended default, no credit card required)
# Get a key at: https://build.nvidia.com
#   - Sign in (free account)
#   - Pick any model (e.g. "meta/llama-3.1-70b-instruct")
#   - Click "Get API Key"
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# OpenAI (paid)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com

# Anthropic (paid)
# ANTHROPIC_API_KEY=

# Local Ollama (free, requires local install)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# LiteLLM proxy (free if you run it locally)
# LITELLM_URL=http://localhost:4000
# LITELLM_MODEL=smart
# LITELLM_MASTER_KEY=sk-empire-change-me

# ============================================================================
# MuAPI (for muapi-studio skill — 535+ models)
# Get at: https://muapi.ai
# ============================================================================
MUAPI_API_KEY=

# ============================================================================
# Other services
# ============================================================================
POSTGRES_URL=postgresql://empire:empire@localhost:5432/empire
REDIS_URL=redis://localhost:6379/0
