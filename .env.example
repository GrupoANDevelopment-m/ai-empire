# =============================================================================
# AI EMPIRE — Environment Configuration
# Copie para .env e ajuste conforme necessário
# =============================================================================

# ---- General ----
TZ=Europe/Paris
PUID=1000
PGID=1000
GPU_COUNT=all

# ---- Database ----
POSTGRES_USER=empire
POSTGRES_PASSWORD=empire_dev_change_me
POSTGRES_DB=ai_empire
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Ollama (LLM local) ----
OLLAMA_PORT=11434
# Modelos default que o script install.sh baixa
OLLAMA_MODELS=llama3.3,qwen3:8b,nomic-embed-text

# ---- Caddy (reverse proxy HTTPS) ----
HTTP_PORT=80
HTTPS_PORT=443
# Domínio (em branco = localhost)
DOMAIN=localhost

# ---- LLM Providers (opcional, fallback do Ollama) ----
# Deixe vazio pra usar 100% local
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- LangSmith / Langfuse (observability) ----
LANGCHAIN_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SECRET=change-me-langfuse
LANGFUSE_SALT=salt-change-me
LANGFUSE_PORT=3002

# ---- Agent services ----
LANGGRAPH_PORT=8123
FLOWISE_PORT=3001
FLOWISE_USER=admin
FLOWISE_PASSWORD=admin
OPENWEBUI_PORT=3000
WEBUI_AUTH=true
WEBUI_SECRET_KEY=change-me-webui

# ---- Browser automation ----
BROWSER_USE_PORT=8001
BROWSER_USE_API_KEY=
BROWSERLESS_PORT=3003
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ---- Leads / outreach ----
OPENOUTREACH_PORT=8002
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
CHATWOOT_PORT=3004
CHATWOOT_SECRET=change-me-chatwoot
DITTOFEED_PORT=3005

# ---- Design ----
PENPOT_PORT=9001
COMFYUI_PORT=8188
FOOOCUS_PORT=7865
INKSCAPE_PORT=3006
GIMP_PORT=3007
KRITA_PORT=3008
BLENDER_PORT=3009

# ---- Video ----
OPENSORA_PORT=8003
WHISPER_PORT=9000
TTS_PORT=8004

# ---- Data ----
SEARXNG_PORT=8888
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
CRAWL4AI_PORT=8005

# ---- CRM ----
TWENTY_PORT=3010
TWENTY_SECRET=change-me-twenty
BASEROW_PORT=3011
BASEROW_SECRET=change-me-baserow
CALCOM_PORT=3012
CALCOM_SECRET=change-me-cal
INVOICE_PORT=3013

# ---- Workflow ----
N8N_PORT=5678
N8N_HOST=localhost
N8N_AUTH=true
N8N_USER=admin
N8N_PASSWORD=admin

# ---- Office ----
STIRLING_PORT=3014
GOTENBERG_PORT=3015

# ---- Critical env vars (added after audit 2026-09-19) ----
# Internal service URLs (used by langgraph, n8n, open-webui to talk to each other)
DATABASE_URL=postgresql://empire:empire_dev_change_me@postgres:5432/ai_empire
REDIS_URL=redis://redis:6379/0
POSTGRES_HOST=postgres
PG_DATABASE_URL=postgresql://empire:empire_dev_change_me@postgres:5432/ai_empire
POSTGRES_USERNAME=empire

# LLM provider URLs
OLLAMA_HOST=http://ollama:11434
OLLAMA_API_BASE=http://ollama:11434
OLLAMA_KEEP_ALIVE=24h

# n8n auth
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin
N8N_PROTOCOL=http

# Langfuse / LangSmith
LANGFUSE_HOST=http://langfuse:3000
LANGCHAIN_TRACING_V2=false

# NextAuth (Flowise, Open WebUI)
NEXTAUTH_SECRET=change-me-nextauth
NEXTAUTH_URL=http://localhost:3000
SECRET_KEY=change-me-secret
SECRET_KEY_BASE=change-me-secret-base
SALT=change-me-salt

# Langfuse encryption
MASTER_KEY=change-me-master-key

# Chatwoot
APP_SECRET=change-me-app-secret
APP_URL=http://localhost:3004
FRONTEND_URL=http://localhost:3004

# Whisper ASR
ASR_ENGINE=openai_whisper
ASR_MODEL=small

# Browser-use Chrome path
CHROME_PATH=/usr/bin/google-chrome
PREBOOT_CHROME=true

# Penpot
PENPOT_FLAGS=disable-secure-session-cookies

# Langfuse DB
STORE_MODEL_IN_DB=true

# Cal.com / Twenty CRM
GENERIC_TIMEZONE=Europe/Paris
MAX_CONCURRENT_SESSIONS=10

# n8n webhook (used internally)
WEBHOOK_URL=http://n8n:5678/

# Flowise
FLOWISE_USERNAME=admin

# Watchtower
WATCHTOWER_LABEL_ENABLE=true
WATCHTOWER_CLEANUP=true
WATCHTOWER_POLL_INTERVAL=86400
OMNIROUTE_PORT=20128

# n8n Node env
NODE_ENV=production
