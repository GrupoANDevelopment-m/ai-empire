# =============================================================================
# AI EMPIRE — Environment Configuration
# Copie para .env e ajuste conforme necessário
# =============================================================================

# ---- General ----
TZ=Europe/Paris
PUID=1000
PGID=1000
GPU_COUNT=all

# ---- Database ----
POSTGRES_USER=empire
POSTGRES_PASSWORD=empire_dev_change_me
POSTGRES_DB=ai_empire
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Ollama (LLM local) ----
OLLAMA_PORT=11434
# Modelos default que o script install.sh baixa
OLLAMA_MODELS=llama3.3,qwen3:8b,nomic-embed-text

# ---- Caddy (reverse proxy HTTPS) ----
HTTP_PORT=80
HTTPS_PORT=443
# Domínio (em branco = localhost)
DOMAIN=localhost

# ---- LLM Providers (opcional, fallback do Ollama) ----
# Deixe vazio pra usar 100% local
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- LangSmith / Langfuse (observability) ----
LANGCHAIN_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SECRET=change-me-langfuse
LANGFUSE_SALT=salt-change-me
LANGFUSE_PORT=3002

# ---- Agent services ----
LANGGRAPH_PORT=8123
FLOWISE_PORT=3001
FLOWISE_USER=admin
FLOWISE_PASSWORD=admin
OPENWEBUI_PORT=3000
WEBUI_AUTH=true
WEBUI_SECRET_KEY=change-me-webui

# ---- Browser automation ----
BROWSER_USE_PORT=8001
BROWSER_USE_API_KEY=
BROWSERLESS_PORT=3003
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ---- Leads / outreach ----
OPENOUTREACH_PORT=8002
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
CHATWOOT_PORT=3004
CHATWOOT_SECRET=change-me-chatwoot
DITTOFEED_PORT=3005

# ---- Design ----
PENPOT_PORT=9001
COMFYUI_PORT=8188
FOOOCUS_PORT=7865
INKSCAPE_PORT=3006
GIMP_PORT=3007
KRITA_PORT=3008
BLENDER_PORT=3009

# ---- Video ----
OPENSORA_PORT=8003
WHISPER_PORT=9000
TTS_PORT=8004

# ---- Data ----
SEARXNG_PORT=8888
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
CRAWL4AI_PORT=8005

# ---- CRM ----
TWENTY_PORT=3010
TWENTY_SECRET=change-me-twenty
BASEROW_PORT=3011
BASEROW_SECRET=change-me-baserow
CALCOM_PORT=3012
CALCOM_SECRET=change-me-cal
INVOICE_PORT=3013

# ---- Workflow ----
N8N_PORT=5678
N8N_HOST=localhost
N8N_AUTH=true
N8N_USER=admin
N8N_PASSWORD=admin

# ---- Office ----
STIRLING_PORT=3014
GOTENBERG_PORT=3015
