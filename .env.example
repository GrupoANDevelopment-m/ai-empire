# AI Empire — REQUIRED configuration
# Copy to .env and fill in real values. NEVER use the defaults in production.

# ─── Required secrets (generate with: openssl rand -hex 32) ─────────────────
POSTGRES_PASSWORD=               # 32+ random chars
REDIS_PASSWORD=                  # 32+ random chars
N8N_BASIC_AUTH_PASSWORD=         # 32+ random chars
LITELLM_MASTER_KEY=              # 32+ random chars, prefix with 'sk-'
SECRET_KEY=                      # 64+ random chars — used by agent API + web UI
JWT_SECRET=                      # 32+ random chars
WEBUI_SECRET_KEY=                # 32+ random chars
CHATWOOT_SECRET_KEY_BASE=        # 64+ random chars
LANGFUSE_SECRET=                 # 64+ random chars
LANGFUSE_SALT=                   # 32+ random chars
CALCOM_SECRET=                   # 64+ random chars
TWENTY_SECRET=                   # 64+ random chars
BASEROW_SECRET_KEY=              # 64+ random chars
INVOICENINJA_APP_KEY=            # 64+ random chars

# ─── Database names ──────────────────────────────────────────────────────────
POSTGRES_USER=empire
POSTGRES_DB=ai_empire
POSTGRES_PORT=5432

# ─── LLM provider keys (optional — at least one is required for non-Ollama) ─
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── External services (optional — enables more features) ───────────────────
APIFY_API_KEY=
CLEARBIT_API_KEY=
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
TWITTER_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=

# ─── Network ─────────────────────────────────────────────────────────────────
TZ=Europe/Paris
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_DOMAIN=                   # e.g. ai.example.com — enables Let's Encrypt

# ─── Tenant isolation ────────────────────────────────────────────────────────
TENANT_MODE=schema               # "schema" or "row"
TENANT_DEFAULT=default

# ─── PII ─────────────────────────────────────────────────────────────────────
PII_REDACT=email,phone,cc        # comma-separated patterns to redact in logs
PII_RETENTION_DAYS=30            # auto-delete conversation logs after N days
PII_AUDIT_LOG=true               # log every tool call (for compliance)

# ─── Rate limits ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=60            # requests per minute per API key
RATE_LIMIT_BURST=120             # burst capacity
RATE_LIMIT_AGENT=20              # LLM calls per minute per tenant

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=     # e.g. http://otel-collector:4317
SENTRY_DSN=                      # optional

# ─── Feature flags ───────────────────────────────────────────────────────────
FEATURE_HITL_REQUIRED=send_outreach,publish_social,run_tests   # actions that need human approval
FEATURE_TELEMETRY=false         # anonymous usage stats
FEATURE_CIRCUIT_BREAKER=true     # auto-disable failing backends

# ─── Auto-Update Notifications (Watchtower + shoutrrr) ───
# Format: provider://token@target
# Examples:
#   WATCHTOWER_NOTIFY_URL=slack://xoxb-token@channel-name
#   WATCHTOWER_NOTIFY_URL=discord://token@channel-id
#   WATCHTOWER_NOTIFY_URL=telegram://token@telegram?channels=chat-id
#   WATCHTOWER_NOTIFY_URL=smtp://user:pass@host:port/?from=a@b&to=c@d
# Multiple: comma-separated
WATCHTOWER_NOTIFY_URL=

# ─── MuAPI Media Generation (500+ models via api.muapi.ai) ───
# Get your key at https://muapi.ai
# Same API used by Open Generative AI studio (https://github.com/Anil-matcha/Open-Generative-AI)
# Without this key, media generation tools return ok:false with a clear message.
MUAPI_API_KEY=

# Optional: use a different MuAPI endpoint (e.g. private deployment)
# MUAPI_BASE_URL=https://api.muapi.ai

# Optional: skip SSL verification (only for local testing with self-signed certs)
# MUAPI_INSECURE_SSL=1
