{
  "annotations": {"list": []},
  "editable": true,
  "id": null,
  "title": "AI Empire — LLM Performance",
  "tags": ["ai-empire", "llm"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "type": "timeseries",
      "title": "LLM Latency by Model",
      "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (model, le) (rate(empire_llm_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{model}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (model, le) (rate(empire_llm_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{model}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM Tokens/second",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum by (model) (rate(empire_llm_tokens_total[1m]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM Cost (cumulative $)",
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum by (model) (empire_llm_cost_dollars_total)",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM Errors",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "sum by (model, error_type) (rate(empire_llm_errors_total[1m]))",
          "legendFormat": "{{model}} - {{error_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top Models by Cost (24h)",
      "id": 5,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "topk(10, sum by (model, tenant_id) (increase(empire_llm_cost_dollars_total[24h])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ]
}
