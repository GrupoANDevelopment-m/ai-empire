{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "title": "AI Empire — Overview",
  "tags": ["ai-empire", "overview"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(empire_requests_total, tenant_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Total Requests (last 1h)",
      "id": 1,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(increase(empire_requests_total{tenant_id=~\"$tenant\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1000},
              {"color": "red", "value": 10000}
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Error Rate (5m)",
      "id": 2,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(empire_requests_total{status=~\"5..\", tenant_id=~\"$tenant\"}[5m])) / sum(rate(empire_requests_total{tenant_id=~\"$tenant\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "p95 Latency (5m)",
      "id": 3,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(empire_request_duration_seconds_bucket{tenant_id=~\"$tenant\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "stat",
      "title": "Active Sessions",
      "id": 4,
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "expr": "empire_active_sessions{tenant_id=~\"$tenant\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Rate by Endpoint",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(empire_requests_total{tenant_id=~\"$tenant\"}[1m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM Token Usage",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "sum by (model, direction) (rate(empire_llm_tokens_total{tenant_id=~\"$tenant\"}[1m]))",
          "legendFormat": "{{model}} {{direction}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool Execution Latency",
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (tool, le) (rate(empire_tool_duration_seconds_bucket{tenant_id=~\"$tenant\"}[5m])))",
          "legendFormat": "p50 {{tool}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (tool, le) (rate(empire_tool_duration_seconds_bucket{tenant_id=~\"$tenant\"}[5m])))",
          "legendFormat": "p95 {{tool}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (tool, le) (rate(empire_tool_duration_seconds_bucket{tenant_id=~\"$tenant\"}[5m])))",
          "legendFormat": "p99 {{tool}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cost per Tenant ($/hour)",
      "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(empire_llm_cost_dollars_total{tenant_id=~\"$tenant\"}[1h]))",
          "legendFormat": "{{tenant_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "type": "timeseries",
      "title": "Sandbox Executions",
      "id": 9,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {
          "expr": "sum by (profile) (rate(empire_sandbox_executions_total{tenant_id=~\"$tenant\"}[1m]))",
          "legendFormat": "{{profile}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "PII Redactions (per minute)",
      "id": 10,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {
          "expr": "sum by (pattern) (rate(empire_pii_redactions_total{tenant_id=~\"$tenant\"}[1m]))",
          "legendFormat": "{{pattern}}",
          "refId": "A"
        }
      ]
    }
  ]
}
